# ── Slack ────────────────────────────────────────────────────────────────────
# From your Slack app (see README). Socket Mode requires both a bot token and an
# app-level token.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# ── Anthropic (the bot's brain) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_MAX_TOOL_ITERATIONS=8

# ── Lumos user MCP server (API key / Bearer auth) ────────────────────────────
# The Lumos user MCP server endpoint. The default is correct for most setups.
LUMOS_MCP_URL=https://api.lumos.com/mcp/user
# The Lumos web app, used for "finish this in the browser" hand-offs.
# LUMOS_WEB_URL=https://app.lumosidentity.com
# A Lumos API key, sent as `Authorization: Bearer <LUMOS_API_KEY>`.
# In the default acting-as mode this key MUST belong to a Lumos admin. Prefer a
# dedicated service account, so request notifications don't go to a person's inbox.
LUMOS_API_KEY=lsk_your_lumos_api_key
# Act on behalf of the Slack user who's chatting (default true): the bot passes
# their verified Slack email as `for_user` so requests are filed for them.
# Requires an admin API key. Set to false to act as a single fixed identity
# (the key owner) — use that with a non-admin key.
# LUMOS_ACT_AS_SLACK_USER=true

# ── Bot behavior ─────────────────────────────────────────────────────────────
# Show a small "Lumos MCP calls: ..." trace under each reply (great for demos).
# SHOW_TOOL_TRACE=true
